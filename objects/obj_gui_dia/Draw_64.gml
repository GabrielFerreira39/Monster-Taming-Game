if instance_position(mouse_x, mouse_y, obj_botao_descanso) {
	draw_text(70, 70, "Descansar... Será que é uma boa ideia agora? Um cochilo é sempre bom!");
	draw_text(70, 140, "Claro, sei que nada se resolve ficando no mesmo lugar, mas...");
	draw_text(70, 160, "Me jogar no meio do perigo sem nenhum preparo também é problemático!");
	draw_text(70, 200, "... Aqui posso conferir quais amigos estarão ao meu lado para enfrentar desafios!");
} if instance_position(mouse_x, mouse_y, obj_botao_gold) {
	draw_text(70, 70, "Dorothy... Ela me disse que vai me ajudar encontrar um caminho de volta para casa!");
	draw_text(70, 140, "Parece que precisamos coletar alguns tijolos para isso...?");
	draw_text(70, 160, "Bem, não sei como isso funciona, mas acredito que ela saiba o que está fazendo.");
	draw_text(70, 200, "... Aqui posso trocar alguns tijolos por ajudas especiais da Dorothy!");
} if instance_position(mouse_x, mouse_y, obj_go_battle) {
	draw_text(70, 70, "Aventurar... Em um mundo perigoso, coragem é importante! E sabedoria! ... E empatia, também!");
	draw_text(70, 140, "Ouvi dizer que há monstros perdidos nessa floresta, assim como eu e a Dorothy...");
	draw_text(70, 160, "Talvez tenha algum jeito de acalma-los com essas cartas mágicas no meu chapéu?");
	draw_text(70, 200, "... Vamos ver o que irá acontecer!");
}