if (alarm0 = true) {
    draw_set_color(c_white);
	if (global.personagem == 0) {
		draw_text(250, 100, "Oiê, Alice! Seja bem-vinda para... Esse abrigo temporário!");
	} else {
		draw_text(250, 100, "Eaí, Ecila! Seja bem-vindo para... Esse abrigo temporário!");
	}
	
    draw_text(140, 150, "Com 20 Tijolos, posso fazer um caminho para um gênero literário da sua escolha!");
	draw_text(140, 200, "E te ajudarei de outras formas, claro, se possível! Confie na Dorothy... Ou seja, eu!");
}